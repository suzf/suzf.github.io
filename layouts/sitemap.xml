{{- /* Sitemap.

       Changes from the theme's version:

       - Taxonomy and term pages are excluded. They hold no content of their
         own and outnumber the posts 60 to 26; they are noindex now (see
         _default/baseof.html), so listing them here would contradict that and
         spend crawl budget on pages we have asked Google not to index.

       - hreflang uses each language's params.hreflang codes (en / zh-CN + zh)
         rather than Hugo's internal lang key (zh-cn), plus x-default for the
         English version, so the sitemap agrees with what the pages themselves
         emit (head/hreflang.html) and with the main suzf.net site.

       - No <changefreq> or <priority>: Google ignores both, and the theme's
         age-based priority only made the file noisier. <lastmod> is the
         hint that counts (from git, see enableGitInfo in hugo.toml), written
         in UTC. */ -}}
{{- $pages := where .Data.Pages "Section" "!=" "gallery" -}}
{{- /* static/sitemap.css lays the file out as a table for a person
       opening it in a browser; crawlers ignore it. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ printf "<?xml-stylesheet type=\"text/css\" href=\"%s\"?>" ("sitemap.css" | relLangURL) | safeHTML }}
{{- $pages = where $pages "Kind" "not in" (slice "taxonomy" "term") }}
<urlset
    xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:xhtml="http://www.w3.org/1999/xhtml"
    >
    {{- range $pages -}}
        <url>
            <loc>
                {{- .Permalink -}}
            </loc>
            {{- /* A list page (blog home, archive) changes whenever one of
                   its posts does, so it takes the newest of its own and its
                   posts' dates; its own file is rarely touched. */ -}}
            {{- $lastmod := .Lastmod -}}
            {{- if .IsNode -}}
                {{- range first 1 (where .RegularPagesRecursive.ByLastmod.Reverse "Section" "!=" "gallery") -}}
                    {{- if .Lastmod.After $lastmod -}}{{- $lastmod = .Lastmod -}}{{- end -}}
                {{- end -}}
            {{- end -}}
            {{- if not $lastmod.IsZero -}}
                <lastmod>
                    {{- $lastmod.UTC.Format "2006-01-02T15:04:05Z07:00" -}}
                </lastmod>
            {{- end -}}

            {{- if .IsTranslated -}}
                {{- range .AllTranslations -}}
                    {{- $href := .Permalink -}}
                    {{- range .Site.Params.hreflang | default (slice (.Language.LanguageCode | default .Language.Lang)) -}}
                        <xhtml:link
                            rel="alternate"
                            hreflang="{{ . }}"
                            href="{{ $href }}"
                            />
                    {{- end -}}
                {{- end -}}
                {{- range where .AllTranslations "Language.Lang" "en" -}}
                    <xhtml:link
                        rel="alternate"
                        hreflang="x-default"
                        href="{{ .Permalink }}"
                        />
                {{- end -}}
            {{- end -}}
        </url>
    {{- end -}}
</urlset>
